            font-size: 14px;
            margin-bottom: 20px;
            line-height: 1.5;
            color: #333;
          }
          .scan-section {
            margin: 40px 0;
          }
          .scan-text {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 20px;
            text-decoration: underline;
          }
          .qr-code {
            margin: 20px 0;
            border: 2px solid #000;
            padding: 10px;
            display: inline-block;
          }
          .or-text {
            font-size: 16px;
            margin: 20px 0;
            font-weight: bold;
          }
          .url-section {
            margin: 20px 0;
          }
          .url-label {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 5px;
          }
          .url-text {
            font-size: 14px;
            font-family: monospace;
            color: #333;
          }
          .thank-you {
            font-size: 18px;
            font-weight: bold;
            margin-top: 30px;
          }
          @media print {
            body { margin: 0; }
          }
        </style>
      </head>
      <body>
        <div class="header">Teaching - Learning Feedback</div>
        
        <div class="instructions">
          Hi Students 👋,<br>
          We'd love to hear how the sessions are going for you in ${y}.<br>
          It will only take 2 minutes — your feedback helps us improve classes.
        </div>
        
        <div class="scan-section">
          <div class="scan-text">Scan Me</div>
          <div class="qr-code">
            <img src="${n}" alt="QR Code" style="max-width: 200px;">
          </div>
        </div>
        
        <div class="or-text">or</div>
        
        <div class="url-section">
          <div class="url-label">visit URL:</div>
          <div class="url-text">${_}</div>
        </div>
        
        <div class="thank-you">Thankyou!!!</div>
        
        <script>
          window.onload = function() {
            window.print();
            setTimeout(() => window.close(), 1000);
          };
        <\/script>
      </body>
      </html>
